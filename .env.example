# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=true
# Required when DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# For HTTPS deployments, e.g. https://kaamsetu.example.com
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata

# Database (DATABASE_URL). Local: your Windows PostgreSQL. Production (Render): your Neon connection string.
#   local : postgresql://postgres:LOCAL_PASSWORD@localhost:5433/kaamsetu_db
#   Render: set DATABASE_URL in the Render dashboard (Neon string); SSL is enforced automatically when DEBUG=false.
# URL-encode special characters in the password (e.g. $ -> %24, @ -> %40).
# If left empty in development only, the app falls back to a local SQLite file.
DATABASE_URL=postgresql://postgres:LOCAL_PASSWORD@localhost:5433/kaamsetu_db

# Encrypts stored Gmail app passwords. Required when DEBUG=false.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes saved app passwords unreadable (users just reconnect Gmail).
TOKEN_ENCRYPTION_KEY=

# Sending
DEFAULT_DAILY_LIMIT=40
SEND_BATCH_SIZE=5
SEND_GAP_SECONDS=1.5
MAX_UPLOAD_MB=5

# AI (optional; users must also switch it on and press the button each time)
# Pick ONE provider with AI_PROVIDER: ollama (local) | ollama_cloud (production) | gemini | none
#
# --- Local development (this file) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b runs on 8 GB machines; qwen3:8b is better but needs ~6 GB free RAM
OLLAMA_MODEL=qwen3:4b
# Seconds to wait for a local reply (CPU-only machines can be slow)
OLLAMA_TIMEOUT=600
#
# --- Production on Render: set these in the Render dashboard, NOT in a committed file ---
#   DEBUG=false
#   AI_PROVIDER=gemini
#   GEMINI_API_KEY=<key from https://aistudio.google.com/apikey>   (server-side only, never sent to the browser)
#   GEMINI_MODEL=gemini-3.5-flash-lite                             (optional)
# Alternative (paid): AI_PROVIDER=ollama_cloud + OLLAMA_BASE_URL=https://ollama.com + OLLAMA_API_KEY + OLLAMA_MODEL
OLLAMA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Emails the app itself sends: verification links and password resets (not your campaign mail) ---
# Leave empty in development: the links are printed in the server log (server.err.log).
# To get real emails, use a Gmail address + app password (https://myaccount.google.com/apppasswords):
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# DEFAULT_FROM_EMAIL=KaamSetu <you@gmail.com>

# --- Google sign-in (optional; the button appears only when both are set) ---
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID > Web application.
# Authorised redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: TTF font for PDF export (full Unicode). Auto-detects Arial on Windows / DejaVu on Linux.
PDF_FONT_PATH=
# Optional: path to tesseract.exe for reading emails from screenshots
TESSERACT_CMD=
