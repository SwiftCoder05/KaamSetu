# Production settings (Render). Copy to .env.production for a local production rehearsal, or set each value as an
# environment variable in the Render dashboard (recommended). Never commit .env.production.
# Run with: APP_ENV=production   (settings then load .env.production instead of .env)

DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database: Neon connection string (SSL is enforced automatically)
DATABASE_URL=

# AI: Gemini free tier (key from https://aistudio.google.com/apikey)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Email verification at sign-up: mandatory | optional | none. "none" lets people sign in without a link, and
# EMAIL_HOST_* below become optional. Switch to mandatory (and fill them in) after deploying.
EMAIL_VERIFICATION=none

# Emails the app sends itself (verification links, password reset): Gmail address + app password.
# Without them, password-reset links are only printed in the server log.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional Google sign-in (redirect URI must be your real https domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Per-user email sending (users connect their own Gmail / Outlook / Yahoo / custom SMTP) ---
# AES-256-GCM key that encrypts every user's SMTP password in the database (base64 of 32 random bytes).
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Changing it later makes saved passwords unreadable (users just reconnect).
EMAIL_ENCRYPTION_KEY=
# Render blocks outbound SMTP, so mail goes through the separate email service in email-service/ (deployed on Vercel).
# Production: your Vercel URL, e.g. https://your-email-service.vercel.app  (no trailing slash).
# Local development: leave EMPTY to connect to SMTP servers directly, or run the service locally:
#   VERCEL_EMAIL_API_URL=http://127.0.0.1:3000   (see email-service/README.md)
VERCEL_EMAIL_API_URL=
# Shared secret, 32+ characters, identical to EMAIL_SERVICE_SECRET on Vercel.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VERCEL_EMAIL_SERVICE_SECRET=
