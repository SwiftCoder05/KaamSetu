# Vercel environment variables (Project Settings > Environment Variables). Placeholders only.

# Must equal VERCEL_EMAIL_SERVICE_SECRET on Render (32+ characters).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
EMAIL_SERVICE_SECRET=

# Optional but recommended: shared state so idempotency and rate limits hold across serverless instances.
# Create a free Upstash Redis database and copy the values from its REST API tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning
# RATE_LIMIT_SEND_PER_MIN=30
# RATE_LIMIT_VERIFY_PER_MIN=10
